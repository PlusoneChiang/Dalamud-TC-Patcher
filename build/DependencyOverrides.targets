<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FFXIVClientStructs'">
    <AssemblyVersion>0.0.6937.0</AssemblyVersion>
    <FileVersion>0.0.6937.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Lumina'">
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <MinVerSkip>true</MinVerSkip>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Lumina.Excel'">
    <AssemblyVersion>7.0.0.0</AssemblyVersion>
    <FileVersion>7.0.0.0</FileVersion>
    <MinVerSkip>true</MinVerSkip>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Lumina.Excel'">
    <PackageReference Remove="Lumina" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\external\Lumina\src\Lumina\Lumina.csproj" />
  </ItemGroup>
</Project>
